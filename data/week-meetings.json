    "zoomPhone": "301-715-8592",
    "livestream": "https://www.youtube.com/@townoftelluridecolorado8739/streams",
    "commentEmail": "townclerk@telluride.gov",
    "hook": "Carhenge: lot consolidation and PUD for town-owned housing"
