{
  "_about": "Expected behaviour per meeting source, for scripts/source-coverage-audit.js (monthly). Keys = week-meetings `source`. packets: the body normally posts a packet (or its one combined agenda+packet PDF). times: meetings carry a start time. recaps: sourceKey in meeting-recaps.js CHANNELS. votes: vote-tracker-config.json entity keys. probe: the page/API the scraper reads; `match` must hit at least once or the page layout probably changed. `api: true` probes are JSON lists checked for suspiciously round counts (the CivicClerk 15-cap). Edit here when a body changes how it publishes.",
  "telluride": { "packets": true, "times": true, "recaps": "telluride", "votes": ["telluride"],
    "probe": { "url": "https://telluride-co.civicweb.net/Services/MeetingsService.svc/meetings?from={today}&to={plus30}", "api": true } },
  "county": { "packets": true, "times": true, "recaps": "county", "votes": ["bocc", "pc"],
    "probe": { "url": "https://sanmiguelcoco.api.civicclerk.com/v1/Events?$filter=startDateTime%20ge%20{today}T00:00:00Z%20and%20startDateTime%20le%20{plus30}T23:59:59Z", "api": true } },
  "mv": { "packets": true, "times": true, "recaps": "mv", "votes": ["tomv", "drb"],
    "probe": { "url": "https://townofmountainvillage.com/government/town-council/town-council/", "match": "town_council_meeting_(?:agenda|packet)" } },
  "school": { "packets": true, "times": true,
    "probe": { "url": "https://www.tellurideschool.org/agendasandminutes", "match": "_packet\\.pdf" } },
  "fire": { "packets": false, "times": true,
    "probe": { "url": "https://www.telluridefire.com/board-meetings", "match": "Agenda[^\"]*\\.pdf" } },
  "med": { "packets": false, "times": true,
    "probe": { "url": "https://www.tellmed.org/board-meetings", "match": "Agenda\\.pdf" } },
  "norwood": { "packets": true, "times": false,
    "probe": { "url": "https://www.norwoodtown.com/board-of-trustees-meetings?year={year}", "match": "Agenda attachment for" } },
  "ophir": { "packets": true, "times": false,
    "probe": { "url": "https://townofophir.colorado.gov/general-assembly-2", "match": "(?:Packet|Agenda)[^\"]*\\.pdf" } },
  "ridgway": { "packets": true, "times": true, "recaps": "ridgway",
    "probe": { "url": "https://townofridgway.colorado.gov/i-want-to/ridgway-town-council", "match": "Packet[^\"]*\\.pdf" } },
  "rico": { "packets": true, "times": true, "recaps": "rico", "votes": ["rico"],
    "probe": { "url": "https://townofrico.colorado.gov/government/board-of-trustees", "match": "(?:Agenda|Packet)[^\"]*\\.pdf" } },
  "ouray": { "packets": true, "times": true, "recaps": "ouray",
    "probe": { "url": "https://ouraycoco.api.civicclerk.com/v1/Events?$filter=startDateTime%20ge%20{today}T00:00:00Z%20and%20startDateTime%20le%20{plus30}T23:59:59Z", "api": true } },
  "ouraycity": { "packets": true, "times": true,
    "probe": { "url": "https://meetings.boardbook.org/Public/Organization/2503", "match": "PublicMeetingsTable" } },
  "smart": { "packets": true, "times": true,
    "probe": { "url": "https://smarttelluride.colorado.gov/board-meetings", "match": "Board[- ](?:Agenda|Packet|Meeting)" } },
  "airport": { "packets": true, "times": true, "packetOnly": true,
    "probe": { "url": "https://tellurideairport.com/wp-json/wp/v2/media?search=Board-Packet&per_page=30&_fields=source_url", "api": true } },
  "tmvoa": { "packets": true, "times": false,
    "probe": { "url": "https://tmvoa.org/meetings-events/meeting-materials/", "match": "(?:agenda|packet)[^\"]*\\.pdf" } }
}
